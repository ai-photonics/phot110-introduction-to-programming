        "#| echo: false\n",
        "from numpy import sqrt, e, exp, sin, cos, pi, log, linspace, ones_like, tanh\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x = linspace(-2.001, 4, 1003)\n",
        "fig, ax = plt.subplots(1, 4, figsize=(14, 4))\n",
        "ax[0].plot(x, exp(x)); ax[0].plot(x, 3*ones_like(x))\n",
        "ax[1].plot(x, 2**x); ax[1].plot(x, 3*x - 2); ax[1].plot(x, 3*x - 1)\n",
        "ax[2].plot(x, tanh(x)); ax[2].plot(x, 1/x**2)\n",
        "ax[3].plot(x, sin(x)); ax[3].plot(x, x)\n",
        "ax[0].legend([r\"$y = e^x$\", r\"$y = 3$\"])\n",
        "ax[1].legend([r\"$y = 2^x$\", r\"$y = 3x-2$\", r\"$y = 3x-1$\"])\n",
        "ax[2].legend([r\"$y = \\tanh(x)$\", r\"$y = \\frac{1}{x^2}$\"])\n",
        "ax[3].legend([r\"$y = \\sin(x)$\", r\"$y = x$\"])\n",
        "for a in ax:\n",
        "  a.set_xlim([-2, 4])\n",
        "  a.set_ylim([-1.5, 9])\n",
        "  a.grid(True)\n",
        "  a.set_xlabel(\"x\")\n",
        "#fig.show()\n",
        "bla = ''"
      ],
